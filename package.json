{
  "name": "pdv",
  "productName": "PDV",
  "version": "2.0.0",
  "description": "Sistema de ponto de venda com controle de caixa, estoque, relatórios e backup pelo Gmail",
  "main": "electron/main.js",
  "author": "PDV",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "br.com.pdv.desktop",
    "productName": "PDV",
    "copyright": "PDV",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "PDV-Instalador-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PDV",
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
